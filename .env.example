# Example environment variables for Rural Companion prototype
# Prefix client-side vars with VITE_ (Vite requirement)

# Example: API key for any external service
VITE_API_KEY=

# Example: Base URL for API server
VITE_API_BASE=

# Port override (optional)
VITE_PORT=5173

# Gemini API key for the AI assistant
# Get one free at https://aistudio.google.com/app/apikey
VITE_GEMINI_API_KEY=your_api_key_here
